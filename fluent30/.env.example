# =====================================================================================
# Fluent30 — configuration du serveur
# Copiez ce fichier en .env.local (développement) ou renseignez ces variables dans
# Vercel → Project → Settings → Environment Variables (production).
# Les clés ne sont lues QUE par le serveur : elles ne sont jamais envoyées au navigateur.
# Ne committez jamais de vraies clés. Les utilisateurs finaux n'ont jamais à saisir de clé.
# =====================================================================================

# ---------- 1. Intelligence artificielle (Anthropic Claude) — RECOMMANDÉ ----------
# Active : fiches de vocabulaire intelligentes, traduction en contexte, conversations, corrections,
# analyse de photos et de captures, journal, My Real Life English, romans, évaluation écrite.
# Où l'obtenir : https://console.anthropic.com/settings/keys (compte + moyen de paiement, paiement à l'usage)
ANTHROPIC_API_KEY=

# Routage des modèles (facultatif — valeurs par défaut optimisées pour le coût) :
#   FAST     : tâches simples et fréquentes (fiches, traduction d'un mot, explications, OCR, objets d'une photo)
#   STANDARD : analyses personnelles (vraie vie, journal, conversations, bilans, liseuse, photos)
#   PREMIUM  : quand la qualité l'exige (romans personnalisés, évaluation de l'expression écrite)
# Tarifs publics Anthropic au 2026-11 (à vérifier) par million de jetons entrée/sortie :
#   claude-haiku-5-5 0,10 $ / 0,50 $ · claude-sonnet-5-5 2 $ / 10 $ · claude-opus-5-5 4 $ / 20 $
# FLUENT30_MODEL_FAST=claude-haiku-5-5
# FLUENT30_MODEL_STANDARD=claude-sonnet-5-5
# FLUENT30_MODEL_PREMIUM=claude-opus-5-5
# FLUENT30_MODEL=claude-opus-5-5            # ancien nom de FLUENT30_MODEL_PREMIUM (toujours accepté)
# FLUENT30_AI_TIMEOUT_MS=120000             # délai maximal d'un appel IA
# Ajuster un tarif si Anthropic le modifie (id du modèle en majuscules, tirets → _) :
# FLUENT30_PRICE_CLAUDE_HAIKU_5_5_IN=0.10
# FLUENT30_PRICE_CLAUDE_HAIKU_5_5_OUT=0.50

# ---------- 2. Images et transcription (OpenAI) — FACULTATIF ----------
# Active : illustrations générées (≈ 0,04 $ l'image, seulement si aucune image libre n'est trouvée)
# et transcription audio côté serveur (≈ 0,003 $/min, pour les navigateurs sans reconnaissance vocale).
# Sans cette clé : images libres de droits (Openverse) + pictogrammes, reconnaissance vocale du navigateur.
# Où l'obtenir : https://platform.openai.com/api-keys
OPENAI_API_KEY=
# FLUENT30_IMAGE_MODEL=gpt-image-1
# FLUENT30_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ---------- 3. Comptes, synchronisation, statistiques (Supabase) — RECOMMANDÉ pour la production ----------
# Active : comptes, sauvegarde et synchronisation entre appareils, protection des fonctions IA (connexion
# obligatoire), quotas et coûts fiables sur plusieurs serveurs, cache partagé des réponses génériques.
# Où l'obtenir : https://supabase.com/dashboard → votre projet → Project Settings → API
# Puis exécutez supabase/schema.sql dans l'éditeur SQL du projet. Offre gratuite suffisante pour démarrer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète, serveur uniquement (ne JAMAIS la préfixer par NEXT_PUBLIC_) :
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 4. Espace administrateur (/admin) ----------
# Au moins l'un des deux. Sans aucun des deux, l'espace admin est désactivé (404).
# Un long mot de passe aléatoire (ex. 32 caractères) :
FLUENT30_ADMIN_TOKEN=
# Ou : e-mails des comptes Supabase autorisés, séparés par des virgules
FLUENT30_ADMIN_EMAILS=

# ---------- 5. Maîtrise des coûts ----------
# Plafonds de dépenses IA (en dollars). Atteints → fonctions IA payantes en pause, le reste fonctionne.
# FLUENT30_DAILY_BUDGET_USD=5
FLUENT30_MONTHLY_BUDGET_USD=50
# Plafond mensuel par utilisateur (défaut 0.40 ; "off" pour désactiver)
# FLUENT30_USER_MONTHLY_BUDGET_USD=0.80
# Alertes à 50 %, 80 % et 100 % du plafond mensuel, envoyées à un webhook (Slack, Discord, ntfy…) — facultatif
# FLUENT30_ALERT_WEBHOOK_URL=
# Quotas par utilisateur et par fonction (défauts : src/lib/plan.ts). Fonctions : enrich, lookup, translate,
# phrase, correct, ocr, identify, words, chat, report, assess, reader, novel, reallife, journal, memories, images, transcribe
# FLUENT30_LIMIT_REALLIFE_PER_DAY=40
# FLUENT30_LIMIT_REALLIFE_PER_MONTH=150
# FLUENT30_LIMIT_JOURNAL_PER_DAY=20
# FLUENT30_LIMIT_MEMORIES_PER_DAY=20
# FLUENT30_MAX_CONCURRENT_PER_USER=3       # appels IA simultanés par utilisateur
# FLUENT30_RATE_LIMIT_PER_MIN=30           # requêtes IA par minute et par utilisateur/IP
# FLUENT30_SHARED_CACHE=on                 # "off" pour désactiver le cache partagé des réponses génériques
# FLUENT30_CACHE_TTL_DAYS=90
# FLUENT30_USAGE_SALT=changez-moi          # sel des identifiants pseudonymes des statistiques

# ---------- 6. Services gratuits (aucune clé) ----------
# Correction grammaticale de secours : API publique LanguageTool, ou votre propre serveur open source
# LANGUAGETOOL_URL=https://api.languagetool.org
# Traduction simple (MyMemory), dictionnaire (Wiktionary), images libres (Openverse), livres (Gutenberg),
# voix et reconnaissance vocale (navigateur), lecture de texte sur image (Tesseract.js) : rien à configurer.
# MyMemory : votre e-mail fait passer le quota gratuit de 5 000 à 50 000 caractères par jour (facultatif)
# MYMEMORY_EMAIL=contact@votre-domaine.fr
# Illustrations : par défaut, images libres (Openverse) puis pictogramme IA bon marché.
# Mettre 1 pour autoriser la génération d'images payante (OpenAI, ≈ 0,04 $ l'image) pour les mots génériques.
# FLUENT30_PAID_IMAGES=0

# ---------- 7. Sans Supabase uniquement ----------
# Protège les fonctions IA d'un déploiement public par un code d'accès partagé (sinon tout le monde peut
# consommer votre budget IA). Inutile si Supabase est configuré (connexion obligatoire).
FLUENT30_ACCESS_CODE=
