# --- Fluent30 server configuration (never commit real keys) ---

# AI (translations in context, enrichment, conversation, correction, OCR). Required for AI features.
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default: claude-opus-5-5)
# FLUENT30_MODEL=claude-opus-5-5

# Optional: OpenAI key for raster illustrations (gpt-image-1) and server-side speech transcription.
# Without it, illustrations are drawn as SVG pictograms by Claude, and speech recognition uses the browser.
OPENAI_API_KEY=

# Optional: Supabase (accounts, cloud backup, sync between devices). See supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, server only: shared illustration cache in Supabase Storage
SUPABASE_SERVICE_ROLE_KEY=

# Optional when Supabase is not used: protect paid AI routes with a shared access code.
FLUENT30_ACCESS_CODE=
# FLUENT30_RATE_LIMIT_PER_MIN=30
